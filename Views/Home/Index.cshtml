@model AgriStreamMVC.Models.DashboardViewModel

@{
    ViewData["Title"] = "Farm Dashboard";
}

<div class="container mt-4">

    <h1 class="mb-2">AgriStream IoT</h1>
    <p class="text-muted">
        Smart Farm Monitoring Dashboard
    </p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">
            @TempData["Message"]
        </div>
    }

    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Total Sensors</h5>
                    <h2>@Model.TotalSensors</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Active Devices</h5>
                    <h2>@Model.ActiveDevices</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Alerts</h5>
                    <h2>@Model.Alerts</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5>Sensor Telemetry</h5>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Sensor</th>
                        <th>Location</th>
                        <th>Temperature</th>
                        <th>Soil Moisture</th>
                        <th>Humidity</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var sensor in Model.Readings)
                    {
                        <tr>
                            <td>@sensor.SensorId</td>
                            <td>@sensor.Location</td>
                            <td>@sensor.Temperature °C</td>
                            <td>@sensor.SoilMoisture %</td>
                            <td>@sensor.Humidity %</td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <div class="row">

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Drone Image Upload</h5>

                    <form asp-controller="Home"
                          asp-action="UploadDroneImage"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="file"
                               name="image"
                               accept="image/*"
                               class="form-control mb-3"
                               required />

                        <button type="submit"
                                class="btn btn-primary">
                            Upload Image
                        </button>

                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Irrigation Control</h5>

                    <p>Device: Pump-001</p>
                    <p>Status: Demo / Idle</p>

                    <form asp-controller="Home"
                          asp-action="TriggerIrrigation"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success">
                            Trigger Irrigation
                        </button>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
